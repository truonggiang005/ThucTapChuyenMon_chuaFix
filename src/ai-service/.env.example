# Sao chép file này thành ".env" (file .env KHÔNG được commit) rồi điền giá trị thật.
GEMINI_API_KEY=your_key_here
# Khóa bí mật dùng chung giữa Spring Boot và AI service (đặt cùng giá trị ở biến môi trường AI_INTERNAL_KEY của Spring).
# Tạo khóa ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_KEY=change_me
# Tùy chọn (chỉ dùng khi phát triển): AI_DEBUG=1 bật /docs và reload; AI_HOST, AI_PORT, AI_ALLOWED_ORIGIN
